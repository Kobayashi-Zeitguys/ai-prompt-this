{
	"name": "ai-prompt-this",
	"version": "1.0.0",
	"description": "AI PromptThis — deep-link buttons to send page content to AI platforms (ChatGPT, Claude, Gemini, Grok, Perplexity).",
	"author": "kobayashizeitguys",
	"license": "GPL-2.0-or-later",
	"scripts": {
		"build": "wp-scripts build --webpack-copy-php",
		"start": "wp-scripts start",
		"format": "wp-scripts format",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js",
		"packages-update": "wp-scripts packages-update",
		"stage": "bash bin/stage.sh",
		"dist": "bash bin/zip.sh",
		"svn:release": "bash bin/svn.sh",
		"make-pot": "wp i18n make-pot . languages/ai-prompt-this.pot --slug=ai-prompt-this --domain=ai-prompt-this --exclude=node_modules,src,vendor",
		"make-json": "wp i18n make-json languages/ --no-purge",
		"update-po": "wp i18n update-po languages/ai-prompt-this.pot languages/"
	},
	"devDependencies": {
		"@wordpress/scripts": "^27.9.0"
	},
	"dependencies": {
		"@wordpress/components": "^27.0.0",
		"@wordpress/element": "^6.1.0",
		"@wordpress/primitives": "^4.1.0"
	}
}
